<UserControl x:Class="WebWeaver.Controls.InfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380" Background="{DynamicResource Brush.PanelBg}"
             BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="0,0,1,0">

    <UserControl.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Background"  Value="{DynamicResource Brush.TextBoxBg}"/>
            <Setter Property="Foreground"  Value="{DynamicResource Brush.TextBoxFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBtn}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- 1. Видимое «лицо» -->
                            <Border x:Name="Bd" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"/>

                            <!-- 2. Текст выбранного элемента и стрелка — клики не перехватывают -->
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                      IsHitTestVisible="False"/>

                            <Path IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,8,0" Data="M0,0 L4,4 8,0"
                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"/>

                            <!-- 3. Невидимая кнопка — ВЕРХНИЙ слой, ловит все клики -->
                            <ToggleButton Focusable="False" ClickMode="Press"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- 4. Выпадающий список -->
                            <Popup x:Name="PART_Popup"
                           IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                           AllowsTransparency="True" Placement="Bottom" PopupAnimation="Slide"
                           MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border Background="{DynamicResource Brush.PanelBg}"
                                BorderBrush="{DynamicResource Brush.BtnBorder}"
                                BorderThickness="1" CornerRadius="4" Margin="0,2,0,0"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextBoxFg}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="3" Background="Transparent"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentBtn}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.BtnText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="16*"/>
            <RowDefinition Height="453*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.TextBoxBg}"
                BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <TextBlock x:Name="tbPanelTitle" Foreground="{DynamicResource Brush.BtnText}" FontSize="14"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="btnClose" Content="✕" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Width="28" Height="28"
                        Background="Transparent" Foreground="{DynamicResource Brush.DescFg}"
                        BorderThickness="0" FontSize="14" Cursor="Hand"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- Содержимое: две вкладки — редактор (1/3) и блокнот (3/4) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,54" Grid.RowSpan="3">
            <StackPanel x:Name="spEditor" Margin="14,10,14,0">

                <!-- Имя -->
                <TextBlock Text="Имя ноды" Foreground="{DynamicResource Brush.LabelFg}" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="txName" Style="{StaticResource FieldBox}" Margin="0,0,0,10"/>

                <!-- РЕЖИМ ПРОСМОТРА/БЛОКНОТА — видно только в режиме 3/4 -->
                <StackPanel x:Name="spViewMode">

                    <!-- заголовок ноды, кнопки, TextBlock «Связанные ноды» ...   -->
                    <TextBlock Text="Связанные ноды" Foreground="{DynamicResource Brush.LabelFg}" FontSize="11" Margin="0,0,0,3"/>

                    <ItemsControl x:Name="icLinks" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                            <Button Content="{Binding DisplayName}"
                            Padding="6,1" Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.AccentBtn}" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="LinkItem_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── НОВОЕ: строка «Текст ноды» + кнопка «Изменить» ── -->
                    <DockPanel Margin="0,0,0,3">
                        <Button x:Name="btnToggleText" DockPanel.Dock="Right"
                Content="Изменить" Padding="10,2" FontSize="11"
                Background="{DynamicResource Brush.AccentBtn}" Foreground="White"
                BorderThickness="0" Cursor="Hand"
                Click="BtnToggleText_Click"/>
                        <TextBlock x:Name="tbTextLabel" Text="Текст ноды"
                   Foreground="{DynamicResource Brush.LabelFg}" FontSize="11"
                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- ── НОВОЕ: подсказка, по умолчанию скрыта ── -->
                    <TextBlock x:Name="tbLinkHint"
               Foreground="#888888" FontSize="10"
               Margin="0,0,0,4" TextWrapping="Wrap"
               Visibility="Collapsed"
               Text="Ссылка на ноду: [отображаемый текст]:[имя ноды]  •  Интернет: [отображаемый текст]:[https://...]"/>

                    <!-- ── Редактор: был txText — заменяем, скрыт по умолчанию ── -->
                    <TextBox x:Name="txText"
             Background="{DynamicResource Brush.TextBoxBg}" 
             Foreground="{DynamicResource Brush.TextBoxFg}"
             MinHeight="180"
             AcceptsReturn="True" AcceptsTab="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             FontFamily="Consolas" FontSize="13"
             Visibility="Collapsed"
             Margin="0,0,0,8"/>

                    <!-- ── Предпросмотр: был rtbPreview — заменяем, виден по умолчанию ── -->
                    <RichTextBox x:Name="rtbPreview"
                        IsReadOnly="True"
                        IsDocumentEnabled="True"
                        Background="{DynamicResource Brush.TextBoxBg}"
                        Foreground="{DynamicResource Brush.TextBoxFg}"
                        BorderBrush="{DynamicResource Brush.BtnBorder}" BorderThickness="1"
                        VerticalScrollBarVisibility="Auto"
                        Margin="0,0,0,8">
                        <FlowDocument Foreground="{DynamicResource Brush.TextBoxFg}"/>
                    </RichTextBox>

                </StackPanel>

                <!-- РЕЖИМ РЕДАКТОРА — только в 1/3 -->
                <StackPanel x:Name="spEditMode">

                    <!-- Текст ноды (краткий) -->
                    <TextBlock Text="Текст ноды" Foreground="{DynamicResource Brush.LabelFg}" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="txTextShort"
                             MinHeight="60" AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource FieldBox}" Margin="0,0,0,10"/>

                    <!-- Цвета -->
                    <TextBlock Text="Цвет фона" Foreground="{DynamicResource Brush.LabelFg}" FontSize="11" Margin="0,0,0,3"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txBgColor" Style="{StaticResource FieldBox}"
                                 Grid.Column="0" TextChanged="ColorBox_Changed"/>
                        <Border x:Name="prevBg" Grid.Column="1"
                                Margin="4,0,0,0" CornerRadius="4"
                                BorderBrush="#555" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonDown="PrevBg_MouseLeftButtonDown"/>
                    </Grid>

                    <TextBlock Text="Цвет заголовка" Foreground="{DynamicResource Brush.LabelFg}" FontSize="11" Margin="0,0,0,3"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txHeaderColor" Style="{StaticResource FieldBox}"
                                 Grid.Column="0" TextChanged="ColorBox_Changed"/>
                        <Border x:Name="prevHeader" Grid.Column="1"
                                Margin="4,0,0,0" CornerRadius="4"
                                BorderBrush="#555" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonDown="PrevHeader_MouseLeftButtonDown"/>
                    </Grid>

                    <TextBlock Text="Цвет текста" Foreground="{DynamicResource Brush.LabelFg}" FontSize="11" Margin="0,0,0,3"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txTextColor" Style="{StaticResource FieldBox}"
                                 Grid.Column="0" TextChanged="ColorBox_Changed"/>
                        <Border x:Name="prevText" Grid.Column="1"
                                Margin="4,0,0,0" CornerRadius="4"
                                BorderBrush="#555" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonDown="PrevText_MouseLeftButtonDown"/>
                    </Grid>

                    <!-- Шрифт -->
                    <TextBlock Text="Шрифт" Foreground="{DynamicResource Brush.LabelFg}" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="cbFont" Margin="0,0,0,10"
                              BorderThickness="1" SelectionChanged="cbFont_SelectionChanged"/>

                    <!--Background="#1C1E24"
                    Foreground="Black"
                    BorderBrush="{DynamicResource Brush.AccentBtn}"-->

                    <!-- Размер шрифта -->
                    <TextBlock Text="Размер шрифта" Foreground="{DynamicResource Brush.LabelFg}" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="txFontSize" Style="{StaticResource FieldBox}" Margin="0,0,0,10"/>

                    <!-- Картинка -->
                    <TextBlock Text="Картинка (путь к файлу)" Foreground="{DynamicResource Brush.LabelFg}" FontSize="11" Margin="0,0,0,3"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txImagePath" Style="{StaticResource FieldBox}" Grid.Column="0"/>
                        <Button Content="📂" Grid.Column="1"
                                Margin="4,0,0,0" Padding="8,4"
                                Background="{DynamicResource Brush.AccentBtn}" Foreground="White"
                                BorderThickness="0"
                                Click="BtnPickImage_Click"/>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,14,14">
            <Button x:Name="btnCancel" Content="Отмена"
                    Width="80" Height="32"
                    Background="{DynamicResource Brush.BtnBg}" Foreground="{DynamicResource Brush.BtnText}"
                    BorderThickness="0" Margin="0,0,8,0"
                    Click="BtnCancel_Click"/>
            <Button x:Name="btnSave" Content="💾 Сохранить"
                    Height="32" Padding="14,0"
                    Background="{DynamicResource Brush.AccentBtn}" Foreground="White"
                    BorderThickness="0" FontWeight="SemiBold"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</UserControl>