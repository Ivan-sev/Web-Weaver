<Window x:Class="WebWeaver.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель"
        Width="560"
        SizeToContent="Height"
        MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#20232B">

    <Window.Resources>
        <!-- Неявный стиль: все кнопки панели автоматически получают его -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#232630"/>
            <Setter Property="BorderBrush" Value="#2A2D38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6,10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#303646"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1C1E24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3C82C8"/>
            <Setter Property="Padding" Value="6,4,6,4"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="14">
        <TextBlock x:Name="tbTitle"
                   FontSize="15" FontWeight="Bold"
                   Foreground="#64B4FF"
                   Margin="2,0,0,12"/>

        <!-- Строки панели добавляются сюда из кода -->
        <StackPanel x:Name="spRows"/>
    </StackPanel>
</Window>