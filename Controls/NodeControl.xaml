<UserControl x:Class="WebWeaver.Controls.NodeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="120" MinHeight="80">
    <Border x:Name="borderMain"
            CornerRadius="8"
            BorderThickness="1.5"
            Background="#282C34"
            BorderBrush="#3C82C8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border x:Name="borderHeader"
                    Grid.Row="0"
                    Background="#3C82C8"
                    CornerRadius="7,7,0,0"
                    Padding="8,5">
                <Grid>
                    <TextBlock x:Name="tbTitle"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- Иконка -->
                    <TextBlock Text="⠿"
                               Foreground="#AACCFF"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="14" Opacity="0.7"
                               ToolTip="Перетащить"/>
                </Grid>
            </Border>

            <!-- Тело -->
            <Grid Grid.Row="1" Margin="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <TextBlock x:Name="tbText"
                                   Foreground="#DCDCDC"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"/>
                        <Image x:Name="imgContent"
                               Stretch="Uniform"
                               Visibility="Collapsed"
                               MaxHeight="200"/>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Правый порт -->
            <Ellipse x:Name="portRight"
                     Width="14" Height="14"
                     Fill="#3C82C8" Stroke="White" StrokeThickness="1.5"
                     HorizontalAlignment="Right" VerticalAlignment="Center"
                     Margin="0,0,-7,0" Grid.RowSpan="2"
                     Cursor="Cross"
                     ToolTip="Соединить (правый порт)"/>

            <!-- Левый порт -->
            <Ellipse x:Name="portLeft"
                     Width="14" Height="14"
                     Fill="#3C82C8" Stroke="White" StrokeThickness="1.5"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     Margin="-7,0,0,0" Grid.RowSpan="2"
                     Cursor="Cross"
                     ToolTip="Соединить (левый порт)"/>

            <!-- Ресайз-хэндл -->
            <Thumb x:Name="resizeThumb"
                   Width="12" Height="12"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Grid.Row="1" Cursor="SizeNWSE"
                   Background="Transparent" BorderThickness="0"
                   ToolTip="Изменить размер"/>
        </Grid>
    </Border>
</UserControl>
