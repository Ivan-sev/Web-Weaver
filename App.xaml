<Application x:Class="WebWeaver.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Базовый TextBox -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background"   Value="#1C1E24"/>
            <Setter Property="Foreground"   Value="#DCDCDC"/>
            <Setter Property="BorderBrush"  Value="#3C82C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="6,4"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="CaretBrush"   Value="White"/>
        </Style>

        <!-- ComboBox -->
        <Style x:Key="ComboField" TargetType="ComboBox">
            <Setter Property="Background"   Value="#1C1E24"/>
            <Setter Property="Foreground"   Value="#DCDCDC"/>
            <Setter Property="BorderBrush"  Value="#3C82C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"     Value="12"/>
        </Style>

        <!-- Кнопка действия -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"   Value="#3C82C8"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="12,6"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A9FE0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2A60A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка-ссылка -->
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="#64B4FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar тонкий тёмный -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1C1E24"/>
            <Setter Property="Foreground" Value="#3C82C8"/>
            <Setter Property="Width"      Value="6"/>
        </Style>

    </Application.Resources>
</Application>
