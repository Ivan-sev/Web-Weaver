<Application x:Class="WebWeaver.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Дефолтные (тёмные) значения. При старте и смене темы
             перезаписываются SettingsManager.ApplyTheme() -->
        <SolidColorBrush x:Key="Brush.WindowBg"       Color="#1C1E24"/>
        <SolidColorBrush x:Key="Brush.ToolbarBg"      Color="#16181F"/>
        <SolidColorBrush x:Key="Brush.ToolbarBorder"  Color="#2A2D38"/>
        <SolidColorBrush x:Key="Brush.PanelBg"        Color="#20232B"/>
        <SolidColorBrush x:Key="Brush.PanelBorder"    Color="#3C82C8"/>
        <SolidColorBrush x:Key="Brush.BtnBg"          Color="#232630"/>
        <SolidColorBrush x:Key="Brush.BtnHover"       Color="#303646"/>
        <SolidColorBrush x:Key="Brush.BtnBorder"      Color="#2A2D38"/>
        <SolidColorBrush x:Key="Brush.BtnText"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Brush.Accent"         Color="#64B4FF"/>
        <SolidColorBrush x:Key="Brush.AccentBtn"      Color="#3C82C8"/>
        <SolidColorBrush x:Key="Brush.TextBoxBg"      Color="#1C1E24"/>
        <SolidColorBrush x:Key="Brush.TextBoxFg"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Brush.LabelFg"        Color="#CCCCCC"/>
        <SolidColorBrush x:Key="Brush.DescFg"         Color="#9AA0B0"/>
        <SolidColorBrush x:Key="Brush.StatusFg"       Color="#606880"/>
        <SolidColorBrush x:Key="Brush.ZoomFg"         Color="#A0C0E0"/>
        <SolidColorBrush x:Key="Brush.CanvasBg"       Color="#1C1E24"/>
        <SolidColorBrush x:Key="Brush.GridDot"        Color="#373A44"/>
        <SolidColorBrush x:Key="Brush.NodePort"       Color="#3C82C8"/>
        <SolidColorBrush x:Key="Brush.NodePortStroke" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Brush.NodeBorder"     Color="#50A0F0"/>
        
        <!-- Базовый TextBox -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background"   Value="{DynamicResource Brush.TextBoxBg}"/>
            <Setter Property="Foreground"   Value="{DynamicResource Brush.TextBoxFg}"/>
            <Setter Property="BorderBrush"  Value="{DynamicResource Brush.AccentBtn}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="6,4"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="CaretBrush"   Value="{DynamicResource Brush.TextBoxFg}"/>
        </Style>

        <!-- Кнопка действия -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"   Value="#3C82C8"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="12,6"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A9FE0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2A60A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка-ссылка -->
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="#64B4FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar тонкий тёмный -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1C1E24"/>
            <Setter Property="Foreground" Value="#3C82C8"/>
            <Setter Property="Width"      Value="6"/>
        </Style>

    </Application.Resources>
</Application>
