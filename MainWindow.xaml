<Window x:Class="WebWeaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:WebWeaver.Controls"
        PreviewKeyDown="Window_PreviewKeyDown"
        Title="Web Weaver"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="500"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        Background="#1C1E24">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="Delete"             Command="{Binding DeleteSelectedCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Верхняя панель инструментов ══ -->
        <Border Grid.Row="0" Background="#16181F" BorderBrush="#2A2D38"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="6,0" LastChildFill="False">

                <TextBlock x:Name="tbSettings" DockPanel.Dock="Left"
                        Text="🕸" ToolTip="Настройки (но еще не работает)"
                        Foreground="#64B4FF" FontSize="14" FontWeight="Bold"
                        VerticalAlignment="Center" Margin="4,0,10,0"
                        MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>

                <Button x:Name="BtnNewNode" DockPanel.Dock="Left" Content="＋ Новая нода"
                        Style="{StaticResource ActionBtn}" Margin="0,0,6,0"
                        Click="BtnNewNode_Click" ToolTip="Создать новую ноду (Insert)"/>

                <Button x:Name="BtnTree" DockPanel.Dock="Left" Content="🌳 Дерево"
                    Style="{StaticResource ActionBtn}" Margin="0,0,6,0"
                    Click="BtnTree_Click" ToolTip="Дерево нод: кто к кому принадлежит"/>

                <Button x:Name="BtnHistory" DockPanel.Dock="Left" Content="⏳ История"
                        Style="{StaticResource ActionBtn}" Margin="0,0,6,0"
                        Click="BtnHistory_Click" ToolTip="История изменений"/>

                <Separator DockPanel.Dock="Left" Background="#2A2D38" Width="1" Margin="4,4"/>

                <Button x:Name="BtnSave" DockPanel.Dock="Left" Content="💾 Сохранить"
                        Style="{StaticResource ActionBtn}" Margin="0,0,6,0"
                        Click="BtnSave_Click" ToolTip="Сохранить карту (Ctrl+S)"/>

                <Button x:Name="BtnOpen" DockPanel.Dock="Left" Content="📂 Открыть"
                        Style="{StaticResource ActionBtn}" Margin="0,0,6,0"
                        Click="BtnOpen_Click" ToolTip="Открыть карту (Ctrl+O)"/>

                <Separator DockPanel.Dock="Left" Background="#2A2D38" Width="1" Margin="4,4"/>

                <Button x:Name="BtnClearAll" DockPanel.Dock="Left" Content="🗑 Очистить всё"
                        Style="{StaticResource ActionBtn}" Margin="0,0,6,0"
                        Click="BtnClearAll_Click" ToolTip="Очистить всё (Ctrl+Del)"/>

                <Button x:Name="BtnFindNode" DockPanel.Dock="Left" Content="🔍 Найти нodу"
                        Style="{StaticResource ActionBtn}" Margin="0,0,6,0"
                        Click="BtnFindNode_Click" ToolTip="Найти ноду (Ctrl+F)"/>

                <Separator DockPanel.Dock="Left" Background="#2A2D38" Width="1" Margin="4,4"/>

                <Button x:Name="BtnZoomIn" DockPanel.Dock="Left" Content="🔍＋" ToolTip="Приблизить (Ctrl+)"
                        Style="{StaticResource ActionBtn}" Margin="0,0,4,0"
                        Click="BtnZoomIn_Click"/>
                <Button x:Name="BtnZoomOut" DockPanel.Dock="Left" Content="🔍−" ToolTip="Отдалить (Ctrl-)"
                        Style="{StaticResource ActionBtn}" Margin="0,0,4,0"
                        Click="BtnZoomOut_Click"/>
                <Button x:Name="BtnResetView" DockPanel.Dock="Left" Content="⊡ Сброс вида" ToolTip="Сбросить масштаб и положение (Ctrl+Home)"
                        Style="{StaticResource ActionBtn}" Margin="0,0,4,0"
                        Click="BtnResetView_Click"/>

                <TextBlock x:Name="tbZoom" DockPanel.Dock="Left"
                           Foreground="#A0C0E0" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           Text="100%"/>

                <TextBlock x:Name="tbStatus" DockPanel.Dock="Right"
                           Foreground="#606880" FontSize="10"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           Text="Готово"/>
            </DockPanel>
        </Border>

        <!-- ══ Основная рабочая область ══ -->
        <Grid Grid.Row="1">

            <!-- Карта (Canvas в скролле) -->
            <Border x:Name="canvasBorder"
                    Background="Transparent"
                    ClipToBounds="True"
                    MouseLeftButtonDown ="CanvasBorder_MouseLeftButtonDown"
                    MouseMove           ="CanvasBorder_MouseMove"
                    MouseLeftButtonUp   ="CanvasBorder_MouseLeftButtonUp"
                    MouseRightButtonUp  ="CanvasBorder_MouseRightButtonUp"
                    MouseWheel          ="MainCanvas_MouseWheel">

                <!-- Сетка (dotted grid, рисуется кодом) -->
                <Grid>
                    <Canvas x:Name="gridCanvas" IsHitTestVisible="False"/>

                    <!-- Трансформируемый слой нод и связей -->
                    <Canvas x:Name="mainCanvas"
                            MouseLeftButtonDown="MainCanvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="MainCanvas_MouseLeftButtonUp"
                            MouseMove="MainCanvas_MouseMove"
                            MouseRightButtonUp="MainCanvas_MouseRightButtonUp"
                            MouseWheel="MainCanvas_MouseWheel"
                            Background="Transparent"
                            ClipToBounds="False">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="scaleT"/>
                                <TranslateTransform x:Name="translateT"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                </Grid>
            </Border>

            <!-- Инфо-панель (поверх карты, прижата влево, скрыта по умолчанию) -->
            <ctrl:InfoPanel x:Name="infoPanel"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Width="320"
                            Margin="-320,0,0,0"
                            Panel.ZIndex="10"/>
        </Grid>
    </Grid>
</Window>