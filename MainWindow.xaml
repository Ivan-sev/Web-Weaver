<Window x:Class="WebWeaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:WebWeaver.Controls"
        PreviewKeyDown="Window_PreviewKeyDown"
        Title="Web Weaver"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="500"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        Background="#1C1E24">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="Delete"             Command="{Binding DeleteSelectedCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Верхняя панель инструментов ══ -->
        <Border Grid.Row="0" Background="#16181F" BorderBrush="#2A2D38"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="6,0" LastChildFill="False">

                <TextBlock x:Name="tbSettings" DockPanel.Dock="Left"
                        Text="🕸" ToolTip="Настройки (но еще не работает)"
                        Foreground="#64B4FF" FontSize="14" FontWeight="Bold"
                        VerticalAlignment="Center" Margin="4,0,10,0"
                        MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>

                <Button x:Name="File" DockPanel.Dock="Left" Content="Файл"
                        Style="{StaticResource ActionBtn}" Margin="0,0,6,0"
                        Click="ButtonPanel"/>

                <Button x:Name="Tools" DockPanel.Dock="Left" Content="Инструменты"
                        Style="{StaticResource ActionBtn}" Margin="0,0,6,0"
                        Click="ButtonPanel"/>

                <Button x:Name="View" DockPanel.Dock="Left" Content="Вид"
                        Style="{StaticResource ActionBtn}" Margin="0,0,6,0"
                        Click="ButtonPanel"/>

                <!--<Separator DockPanel.Dock="Left" Background="#2A2D38" Width="1" Margin="4,4"/>-->

                <TextBlock x:Name="tbZoom" DockPanel.Dock="Right"
                           Foreground="#A0C0E0" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           Text="100%"/>

                <TextBlock x:Name="tbStatus" DockPanel.Dock="Right"
                           Foreground="#606880" FontSize="10"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           Text="Готово"/>
            </DockPanel>
        </Border>

        <!-- ══ Основная рабочая область ══ -->
        <Grid Grid.Row="1">

            <!-- Карта (Canvas в скролле) -->
            <Border x:Name="canvasBorder"
                    Background="Transparent"
                    ClipToBounds="True"
                    MouseLeftButtonDown ="CanvasBorder_MouseLeftButtonDown"
                    MouseMove           ="CanvasBorder_MouseMove"
                    MouseLeftButtonUp   ="CanvasBorder_MouseLeftButtonUp"
                    MouseRightButtonUp  ="CanvasBorder_MouseRightButtonUp"
                    MouseWheel          ="MainCanvas_MouseWheel">

                <!-- Сетка (dotted grid, рисуется кодом) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="9*"/>
                        <ColumnDefinition Width="71*"/>
                    </Grid.ColumnDefinitions>
                    <Canvas x:Name="gridCanvas" IsHitTestVisible="False" Grid.ColumnSpan="2"/>

                    <!-- Трансформируемый слой нод и связей -->
                    <Canvas x:Name="mainCanvas"
                            MouseLeftButtonDown="MainCanvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="MainCanvas_MouseLeftButtonUp"
                            MouseMove="MainCanvas_MouseMove"
                            MouseRightButtonUp="MainCanvas_MouseRightButtonUp"
                            MouseWheel="MainCanvas_MouseWheel"
                            Background="Transparent"
                            ClipToBounds="False" Grid.ColumnSpan="2">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="scaleT"/>
                                <TranslateTransform x:Name="translateT"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                </Grid>
            </Border>

            <!-- Инфо-панель (поверх карты, прижата влево, скрыта по умолчанию) -->
            <ctrl:InfoPanel x:Name="infoPanel"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Width="320"
                            Margin="-320,0,0,0"
                            Panel.ZIndex="10"/>
        </Grid>
    </Grid>
</Window>